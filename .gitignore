# Local build (not cross-compiled)
/webtmux

# builds/ is NOT committed — it holds build artifacts (make docker-artifact,
# make cross-compile) and, from v0.1.0, GitHub Release assets. History still
# carries pre-v0.1.0 blobs — sunk cost; no rewrite (it would break live worktrees).
/builds/

# Harness scratch: the throwaway binary the screenshot/verify drivers build, and
# the crops they write. Both are regenerated by a container run; neither is source.
/webtmux-test
/screenshots/verify/

# Throwaway ssh key + state for test/launcher/run.sh. Inside the repo because
# the test daemon can only bind-mount paths under the workspace.
/.launcher-rig/
